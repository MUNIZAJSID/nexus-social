# Configurações do Servidor
PORT=5000
HOST=0.0.0.0
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Segurança e Sessão
JWT_SECRET=localsocial_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Banco de Dados (SQLite por padrão para rodar local sem instalar nada)
# Para usar PostgreSQL, descomente a linha abaixo e comente o SQLite:
DATABASE_URL="file:./localsocial.db"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/localsocial?schema=public"

# Armazenamento Local
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=50

# Conta Administrador Padrão (Criada no seed)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@localsocial.local
ADMIN_PASSWORD=admin123
ADMIN_NAME=Administrador do Sistema
