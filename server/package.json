{
  "name": "localsocial-server",
  "version": "1.0.0",
  "description": "Backend API and WebSocket Server for LocalSocial",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "prebuild": "node -e \"const fs=require('fs'); if(!fs.existsSync('.env')) fs.writeFileSync('.env', 'DATABASE_URL=\\\"file:./localsocial.db\\\"\\nJWT_SECRET=nexus_secret_jwt_2026\\n');\"",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "predb:push": "node -e \"const fs=require('fs'); if(!fs.existsSync('.env')) fs.writeFileSync('.env', 'DATABASE_URL=\\\"file:./localsocial.db\\\"\\nJWT_SECRET=nexus_secret_jwt_2026\\n');\"",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "backup": "tsx src/scripts/backup.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.1",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
